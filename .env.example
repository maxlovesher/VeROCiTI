# Optional backend settings (read from the environment; nothing here is required to run locally).
# Cloud storage for evidence snapshots. Without these, snapshots are served from local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional remote GPU inference service for image uploads. Leave empty to run everything locally.
AI_BACKEND_URL=

# Vision-language model used for make/model, damage and clothing recognition.
CLIP_MODEL_ID=openai/clip-vit-large-patch14

# Team sign-in accounts: a JSON list. Generate it with
#   python "city flow model/scripts/make_team_members.py" you@example.com:your-password
# On Render, add it as an environment variable named TEAM_MEMBERS (it stays private, unlike source code).
# If unset, only the public demo account demo@verociti.dev / verociti-demo can sign in.
TEAM_MEMBERS=
